min-release-age=7

# Hoist packages that Nuxt modules (e.g. @nuxtjs/mdc) pre-bundle via
# Vite optimizeDeps.include. Without this, pnpm's strict node_modules
# layout hides these transitives from Vite's optimizer.
public-hoist-pattern[]=*remark*
public-hoist-pattern[]=*rehype*
public-hoist-pattern[]=*unist-util-*
public-hoist-pattern[]=unified
public-hoist-pattern[]=parse5
public-hoist-pattern[]=debug
public-hoist-pattern[]=extend
